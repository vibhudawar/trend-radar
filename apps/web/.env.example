# apps/web/.env.local — copy to apps/web/.env.local and fill in. Never commit the real env.
# On Vercel, set these in Project Settings → Environment Variables instead.

# --- database (Drizzle) ---
DATABASE_URL=postgresql://...                    # Supabase connection string (same DB as the worker)

# --- Supabase auth (browser-exposed; safe to be public) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...         # Supabase anon/publishable key

# --- onboarding AI prefill ---
OPENAI_API_KEY=sk-...
ONBOARDING_MODEL=gpt-5-mini                       # optional; defaults to gpt-5-mini

# --- worker trigger (Refresh button) ---
WORKER_URL=http://localhost:8000                  # deployed: the Render worker URL (https://trendradar-worker.onrender.com)
WORKER_SECRET=                                    # MUST match WORKER_SECRET set on the worker (Render)
