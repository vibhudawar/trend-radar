# worker/.env — copy to worker/.env and fill in. Never commit the real .env.

# --- required secrets ---
DATABASE_URL=postgresql://...            # Supabase connection string (session pooler)
OPENAI_API_KEY=sk-...                    # embeddings + hook/vision/adapt LLM calls
SCRAPECREATORS_API_KEY=...               # ScrapeCreators (1 credit = 1 request)

# Shared secret the web app sends (X-Worker-Secret) to authorize a refresh.
# MUST match WORKER_SECRET set on the web host (Vercel). Leave blank locally to run without auth.
WORKER_SECRET=

# --- data source ---
DATA_SOURCE=scrapecreators               # "scrapecreators" (live) | "fixture" (replay cached JSON, 0 credits)

# --- optional ---
APIFY_API_KEY=                           # only if using the Apify fallback DataSource
TRENDING_REGIONS=US,IN                   # Trending Songs cron regions (comma-separated)

# --- tuning knobs (defaults in config.py; override only if needed) ---
# CREDIT_CAP_PER_RUN=40
# MIN_OUTPERFORMANCE=1.5
# MAX_OUTPERFORMANCE=75
# MIN_CONCEPT_VIDEOS=2
# MIN_CONCEPT_CREATORS=2
# CLUSTER_SIM_THRESHOLD=0.78
# ENRICH_RESERVE_FRAC=0.5
